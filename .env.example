# Copy this file to .env and fill in real values. Never commit .env.

# Runtime environment: "production" enables secure cookies and caching.
NODE_ENV=development
PORT=3000

# MongoDB connection string and database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=Kaivan
MONGODB_DB=kaivan

# Admin credentials. Generate the hash with: npm run hash-password -- "<password>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to the number of reverse proxies in front of the app (e.g. 1 on Render/Heroku/Nginx).
TRUST_PROXY=0
